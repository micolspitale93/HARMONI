<launch>
    
	<arg name="instance_id" default="default"/> 
    
	<param name="instance_id" value="$(arg instance_id)"/>
    <rosparam file="$(find harmoni_pytree)/config/group_configuration.yaml" subst_value="True"/>

    <!-- In order to launch visual_bg we need the following services from HARMONI -->
    <include file="$(find harmoni_stt)/launch/stt_sd_azure_service.launch"></include>
    <include file="$(find harmoni_bot)/launch/bot_service.launch"></include>
    <include file="$(find harmoni_led)/launch/led_service.launch"></include>
    <include file="$(find harmoni_speaker)/launch/speaker_service_nao.launch"></include>
    <!--
    <arg name="web_directory_path" value="$(find harmoni_web)/web"/>
    <arg name="port" default="8082"/>
	<node pkg="harmoni_web" type="http_server_runner.py" name="web_http_server" output="screen" args="$(arg web_directory_path) $(arg port)" />
	<node pkg="harmoni_web" type="web_service.py" name="harmoni_web_$(arg instance_id)" output="screen"/>
	<include ns="bridge_web" file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"/> -->
    <rosparam file="$(find harmoni_speaker)/config/configuration.yaml" subst_value="True"/>
    <node pkg="harmoni_speaker" type="speaker_service_furhat.py" name="harmoni_speaker_furhat" output="screen"  args="furhat"/>
    <node pkg="harmoni_pytree" type="pytree_group_interaction.py" name="harmoni_pytree_default" output="screen"/>
    <include file="$(find harmoni_recorder)/launch/recording_rosbag_group.launch"></include>
    
</launch>
