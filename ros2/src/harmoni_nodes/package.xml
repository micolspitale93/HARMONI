<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harmoni_nodes</name>
  <version>2.0.0</version>
  <description>
    ROS2 nodes of HARMONI. They are thin wrappers around the ROS-independent HARMONI core
    (core/harmoni): harmoni_service serves any service backend as a ROS2 action, harmoni_tree
    runs a HARMONI tree file and publishes its status.
  </description>
  <maintainer email="micol.spitale@gmail.com">Micol Spitale</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>harmoni_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
