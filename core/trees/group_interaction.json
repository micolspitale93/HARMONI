{
  "harmoni_tree": 1,
  "name": "GroupInteraction",
  "description": "A discussion among humans and robots, moderated by an LLM orchestrator. At every turn the next scene of the script is either said as written by one agent, or decided by the orchestrator: whether an agent intervenes, which one (by role), what it says and to whom. If nobody should intervene the speaking step is skipped and the microphone is reopened. The cast lists the humans and the agents: the same tree works with any number of them, and which robot plays which role is set by the configuration.",
  "variables": {
    "participants": "Micol",
    "script": "scripts/group_interaction.json",
    "max_scenes": 32,
    "orchestrator": "bot_default",
    "stt": "stt_default",
    "llm_timeout_s": 60,
    "speech_timeout_s": 60,
    "listen_timeout_s": 180
  },
  "cast": {
    "humans": "${participants}",
    "agents": [
      {
        "role": "Mover",
        "name": "Manny",
        "robot": "Furhat",
        "services": {
          "speech": "speaker_furhat",
          "led": "led_furhat"
        }
      },
      {
        "role": "Opposer",
        "name": "Sam",
        "robot": "NAO",
        "services": {
          "speech": "speaker_nao",
          "led": "led_nao"
        }
      }
    ]
  },
  "stop_when": "scene/finished",
  "root": {
    "type": "Sequence",
    "name": "GroupInteraction",
    "children": [
      {
        "type": "AgentsAction",
        "name": "Processing light",
        "params": {
          "channel": "led",
          "input_value": "red",
          "wait": false
        }
      },
      {
        "type": "DialogueScript",
        "name": "Script",
        "params": {
          "script": "${script}",
          "max_scenes": "${max_scenes}"
        }
      },
      {
        "type": "Selector",
        "name": "Decide",
        "children": [
          {
            "type": "Sequence",
            "name": "Scripted scene",
            "children": [
              {
                "type": "CheckValue",
                "name": "Is scripted",
                "params": {
                  "key": "scene/nlp",
                  "equals": 0
                }
              },
              {
                "type": "ScriptedTurn",
                "name": "Use script line"
              }
            ]
          },
          {
            "type": "Sequence",
            "name": "Orchestrator scene",
            "children": [
              {
                "type": "ServiceAction",
                "name": "Ask orchestrator",
                "params": {
                  "service": "${orchestrator}",
                  "action": "REQUEST",
                  "input_key": "scene/utterance",
                  "output_key": "bot/raw",
                  "timeout_s": "${llm_timeout_s}",
                  "on_timeout": "success",
                  "timeout_output": "",
                  "on_failure": "success"
                }
              },
              {
                "type": "OrchestratorDecision",
                "name": "Parse decision"
              }
            ]
          }
        ]
      },
      {
        "type": "AgentSpeak",
        "name": "Chosen agent speaks",
        "params": {
          "timeout_s": "${speech_timeout_s}"
        }
      },
      {
        "type": "Selector",
        "name": "Listen",
        "children": [
          {
            "type": "CheckValue",
            "name": "Interaction finished",
            "params": {
              "key": "scene/finished",
              "equals": true
            }
          },
          {
            "type": "Sequence",
            "name": "Listening",
            "children": [
              {
                "type": "Parallel",
                "name": "Listen with green light",
                "params": {
                  "policy": "all"
                },
                "children": [
                  {
                    "type": "ServiceAction",
                    "name": "Speech to text",
                    "params": {
                      "service": "${stt}",
                      "action": "REQUEST",
                      "output_key": "stt/result",
                      "timeout_s": "${listen_timeout_s}",
                      "on_timeout": "success",
                      "timeout_output": "No one is talking. Please initiate a question to reignite the conversation.",
                      "on_failure": "success",
                      "failure_output": ""
                    }
                  },
                  {
                    "type": "AgentsAction",
                    "name": "Listening light",
                    "params": {
                      "channel": "led",
                      "input_value": "green",
                      "wait": false
                    }
                  }
                ]
              },
              {
                "type": "LogUtterance",
                "name": "Log what was said"
              }
            ]
          }
        ]
      }
    ]
  }
}
