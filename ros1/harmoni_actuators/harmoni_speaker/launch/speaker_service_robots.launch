<!-- This is an example launch file for how a ROS application could use a node -->
<launch>
	<arg name="use_furhat" default="true"/>
	<arg name="use_nao" default="false"/>
	<arg name="instance_id" default="default"/>
  	<group if="$(arg use_furhat)">
		<rosparam file="$(find harmoni_speaker)/config/configuration.yaml" subst_value="True"/>
		<param name="instance_id" value="$(arg instance_id)"/>
		<node pkg="harmoni_speaker" type="speaker_service_furhat.py" name="harmoni_speaker_$(arg instance_id)" output="screen"  args="$(arg instance_id)"/>
  	</group>
	<group if="$(arg use_nao)">
		<rosparam file="$(find harmoni_speaker)/config/configuration.yaml" subst_value="True"/>
		<param name="instance_id" value="$(arg instance_id)"/>
		<node pkg="harmoni_speaker" type="speaker_service_nao.py" name="harmoni_speaker_$(arg instance_id)" output="screen"  args="$(arg instance_id)"/>
  	</group>
    
</launch>
