# HARMONI credentials and settings
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root (./harmoni.sh setup does it for you)
# and fill in only the services you use. `.env` is git-ignored: never commit it.
#
# Inside the containers the repository is mounted at /root/harmoni_catkin_ws/src/HARMONI,
# which is where the services read this file from (override with HARMONI_ENV_FILE).

# --- OpenAI (harmoni_bot chatgpt_service.py) --------------------------------
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# --- Azure OpenAI Assistants (harmoni_bot assistant_service.py, group interaction) ---
# e.g. https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_ENDPOINT=
AZURE_OPENAI_API_KEY=

# --- Azure Speech, speaker diarization (harmoni_stt sd_azure_service.py) ----
MICROSOFT_SPEECH_KEY=
# e.g. westeurope
MICROSOFT_SPEECH_REGION=

# --- AWS (Polly TTS, Lex bot) ------------------------------------------------
# AWS credentials are NOT read from here: run `aws configure` on the host,
# ~/.aws is mounted in the containers.

# --- Google (STT, Dialogflow) ------------------------------------------------
# Google credentials are NOT read from here: put the service account key at
# ~/.gcp/private-keys.json/private-keys.json on the host (see doc/configuration/Cloud-Services.md).
